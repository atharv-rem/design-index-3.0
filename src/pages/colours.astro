---
import HomescreenLayout from "../layouts/homescreen.astro";
import ToolsGrid from "../components/tools-grid";
import { getSponsorCards } from "@/lib/sponsors";
import { getToolsByCategory } from "@/lib/get-tool-by-category";
import { PAGE_CACHE, TOOL_DATA_TAG, categoryTag } from "@/lib/page-cache";

// Independent lookups, so they run together. A failure in either still fails the page, as before.
const [tools, sponsors] = await Promise.all([getToolsByCategory("colour"), getSponsorCards()]);
if (Astro.cache.enabled) {
	Astro.cache.set({
		...PAGE_CACHE,
		tags: [TOOL_DATA_TAG, categoryTag("colour")],
	});
}
---

<HomescreenLayout
	title="Colours | Design Index"
	description="A curated collection of colour palettes, hues, gradients and backgrounds to inspire and streamline your design process. From bold primaries to subtle pastels, this section offers a versatile range of colour resources to help you build consistent, visually appealing, and emotionally resonant design systems."
	backgroundVariant="slate"
>
	<main class="mt-[15px] px-[20px]">
		<section>
			<div>
				<h1 class="font-google font-semibold text-4xl leading-none theme-text-primary md:text-[40px] tracking-[0.05rem]">
					Colours
				</h1>
				<p class="hidden md:block mt-3 font-rethink text-[20px] leading-[18px] theme-text-muted md:text-base font-medium">
					A curated collection of colour palettes, hues, gradients and backgrounds to inspire and streamline your design process. From bold primaries to subtle pastels, this section offers a versatile range of colour resources to help you build consistent, visually appealing, and emotionally resonant design systems
				</p>
				<p class="block md:hidden mt-3 font-rethink text-[15px] leading-[18px] theme-text-muted md:text-base font-medium">
					A curated collection of colour palettes, gradients, and backgrounds to inspire your design process. Explore bold to subtle hues that help build consistent and visually appealing design systems.
				</p>
				<ToolsGrid
					client:load
					category="colour"
					initialTools={tools}
					sponsors={sponsors}
				/>
			</div>
		</section>
	</main>
</HomescreenLayout>
