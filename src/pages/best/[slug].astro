---
import HomescreenLayout from "@/layouts/homescreen.astro";
import IconToolCard from "@/components/icon-tool-card.astro";
import ArticleHeader from "@/components/article-header.astro";
import ArticleCompareTable from "@/components/article-compare-table";
import {
  ARTICLE_AUTHOR,
  ARTICLE_PUBLISHED,
  SITE_URL,
  buildCompareRows,
  getIconPages,
  jsonLd,
} from "@/lib/icon-pages";

export const prerender = false;

let pages;

try {
  pages = await getIconPages();
} catch (error) {
  Astro.logger.error(`Failed to load icon articles: ${error}`);
  return new Response(null, { status: 502, statusText: "Bad Gateway" });
}

const page = pages.roundups.find((item) => item.slug === Astro.params.slug);

if (!page) {
  return new Response(null, { status: 404, statusText: "Not Found" });
}

if (Astro.cache.enabled) {
  Astro.cache.set({ maxAge: 3600, swr: 86400, tags: ["icon-articles"] });
}

const rows = buildCompareRows(page.tools);
const showBestFor = rows.some((row) => row.bestFor);
const pageUrl = `${SITE_URL}${page.path}`;
---

<HomescreenLayout
  title={page.seoTitle}
  description={page.metaDescription}
  keywords={`${page.title.toLowerCase()}, icon libraries, icon sets`}
  backgroundVariant="slate"
>
  <script type="application/ld+json" set:html={jsonLd({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "BreadcrumbList",
        "itemListElement": [
          { "@type": "ListItem", "position": 1, "name": "Design Index", "item": SITE_URL },
          { "@type": "ListItem", "position": 2, "name": "Icons", "item": `${SITE_URL}/icons` },
          { "@type": "ListItem", "position": 3, "name": "Best icon lists", "item": `${SITE_URL}/best` },
          { "@type": "ListItem", "position": 4, "name": page.title, "item": pageUrl },
        ],
      },
      {
        "@type": "ItemList",
        "name": page.title,
        "numberOfItems": page.tools.length,
        "itemListOrder": "https://schema.org/ItemListOrderAscending",
        "itemListElement": page.tools.map((tool, index) => ({
          "@type": "ListItem",
          "position": index + 1,
          "name": tool.name,
          "url": `${SITE_URL}${tool.detailHref}`,
        })),
      },
    ],
  })} />

  <main class="px-5 pb-20 pt-6 md:px-6">
    <div class="mx-auto w-full max-w-[640px]">
      <ArticleHeader code={page.code} title={page.title} author={ARTICLE_AUTHOR} date={ARTICLE_PUBLISHED} />

      <div class="mt-8 space-y-3 text-justify hyphens-auto font-(family-name:--font-inter-stack) text-[17px] font-medium leading-[1.35] theme-text-muted">
        {page.intro.map((paragraph) => <p>{paragraph}</p>)}
      </div>

      <section class="mt-10" aria-labelledby="list-heading">
        <h2 id="list-heading" class="font-google text-2xl font-medium theme-text-primary">
          {page.tools.length} icon libraries
        </h2>
        <ol class="mt-5 grid grid-cols-1 gap-6 lg:grid-cols-2">
          {page.tools.map((tool, index) => (
            <li class="flex">
              <IconToolCard tool={tool} priority={index < 2} currentPath={page.path} />
            </li>
          ))}
        </ol>
      </section>

      <section class="mt-12" aria-labelledby="compare-heading">
        <h2 id="compare-heading" class="font-google text-2xl font-medium theme-text-primary">
          {page.title} compared
        </h2>
        <ArticleCompareTable rows={rows} showBestFor={showBestFor} />
      </section>

      <section class="mt-12" aria-labelledby="related-heading">
        <h2 id="related-heading" class="font-google text-2xl font-medium theme-text-primary">
          More icon lists
        </h2>
        <ul class="mt-3 flex flex-wrap gap-2">
          {page.related.map((link) => (
            <li>
              <a href={link.href} class="inline-flex rounded-[12px] px-3 py-1.5 font-google text-[14px] font-semibold theme-text-primary ring-1 ring-black/10 hover:underline dark:ring-white/15">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </section>
    </div>
  </main>
</HomescreenLayout>
