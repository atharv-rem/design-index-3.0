---
import HomescreenLayout from "../layouts/homescreen.astro";
import { actions } from "astro:actions";
import { GET as getStats } from "./api/stats";

export const prerender = false;

const result = Astro.getActionResult(actions.submitSponsor);

if (result && !result.error) {
  return Astro.redirect(`${Astro.url.pathname}?success=true`);
}

let success = Astro.url.searchParams.get("success") === "true";
let errorMessage = result?.error ? result.error.message : "";

let stats: { pageviews: number; visitors: number } | null = null;
try {
	const statsResponse = await getStats();
	if (statsResponse.ok) {
		const data = await statsResponse.json();
		if (data.pageviews > 0 || data.visitors > 0) stats = data;
	}
} catch {
	// Analytics unavailable: the section is simply hidden.
}

const formatter = new Intl.NumberFormat("en-US");
const statCards = stats
	? [
			{ label: "Page views", value: formatter.format(stats.pageviews) },
			{ label: "Unique visitors", value: formatter.format(stats.visitors) },
		]
	: [];

const sponsorBenefits = [
	"We actively review tools by hand and add your product to Design Index ourselves, so it sits in a curated list.",
	"We also post your tool on LinkedIn, Instagram, Threads and Twitter.",
	"On every content page, your ad is rendered in the 8th slot.",
	"In every search result, your ad is rendered as the first tool.",
	"On every tool page, your ad is rendered in the suggested tools.",
];

const labelClass = "flex flex-col gap-2 font-google text-sm font-medium tracking-[0.02rem] theme-text-soft";
const fieldClass =
	"rounded-lg border border-app-border bg-app-panel-contrast px-3 font-(family-name:--font-inter-stack) text-sm normal-case tracking-normal theme-text-primary transition-colors placeholder:theme-text-soft hover:border-app-border-strong focus:border-app-border-strong focus:outline-none focus-visible:ring-2 focus-visible:ring-app-border";
---

<HomescreenLayout
	title="Sponsor Design Index | Advertise to Designers"
	description="Put your product in front of designers. Get in touch to sponsor Design Index."
	keywords="sponsor design index, advertise to designers, design tool sponsorship"
	backgroundVariant="slate"
>
	<main class="px-5 py-6 md:py-8">
		<div class="mx-auto w-full max-w-xl">
			<header>
				<h1 class="font-google text-4xl font-semibold leading-none tracking-[0.01rem] theme-text-primary md:text-[44px]">Become a Sponsor</h1>
			</header>

			{statCards.length > 0 && (
				<section class="mt-8" aria-labelledby="reach-heading">
					<h2 id="reach-heading" class="font-google text-xs font-semibold uppercase tracking-[0.12rem] theme-text-soft">Our reach · last 30 days</h2>
					<div class="mt-3 grid grid-cols-2 gap-3">
						{statCards.map((stat) => (
							<div class="rounded-xl border border-app-border bg-app-panel-contrast p-4">
								<p class="font-google text-3xl font-semibold leading-none tabular-nums theme-text-primary md:text-4xl">{stat.value}</p>
								<p class="mt-3 font-(family-name:--font-inter-stack) text-xs font-medium theme-text-muted">{stat.label}</p>
							</div>
						))}
					</div>
				</section>
			)}

			<section class="mt-8" aria-labelledby="benefits-heading">
				<h2 id="benefits-heading" class="font-google text-xs font-semibold uppercase tracking-[0.12rem] theme-text-soft">What sponsors get</h2>
				<ul class="mt-3 divide-y divide-app-border overflow-hidden rounded-xl border border-app-border bg-app-panel-contrast">
					{sponsorBenefits.map((benefit) => (
						<li class="flex items-start gap-3 px-4 py-3.5">
							<span class="mt-0.5 flex size-5 shrink-0 items-center justify-center rounded-full bg-emerald-500/15 text-emerald-600 dark:text-emerald-400">
								<svg viewBox="0 0 24 24" class="size-3" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
									<path d="M5 12.5l4.5 4.5L19 7.5" />
								</svg>
							</span>
							<span class="font-(family-name:--font-inter-stack) text-sm font-medium leading-5 theme-text-muted md:text-[15px]">{benefit}</span>
						</li>
					))}
				</ul>
			</section>

			<section class="mt-8">
				<p class="mb-5 font-google text-lg font-semibold leading-snug theme-text-primary md:text-xl">Sponsorship should be a minimum of 10 dollars.</p>
				<form action={actions.submitSponsor} method="post">
					<div class="grid gap-4 md:grid-cols-2">
						<label class={labelClass}>
							Company name
							<input type="text" name="companyName" placeholder="Acme" required autocomplete="organization" class:list={["h-11", fieldClass]} />
						</label>

						<label class={labelClass}>
							Website
							<input type="url" name="websiteUrl" placeholder="https://example.com" required autocomplete="url" class:list={["h-11", fieldClass]} />
						</label>
					</div>

					<label class={`mt-4 ${labelClass}`}>
						Your email
						<input type="email" name="email" placeholder="you@example.com" required autocomplete="email" class:list={["h-11", fieldClass]} />
					</label>

					<label class={`mt-4 ${labelClass}`}>
						Message
						<textarea
							name="message"
							rows="5"
							placeholder="Tell us about your product and what you are looking for."
							required
							class:list={["resize-y py-2.5", fieldClass]}
						></textarea>
					</label>

					{success && (
						<div role="status" class="mt-5 rounded-lg border border-emerald-500/30 bg-emerald-500/10 px-3.5 py-3 font-(family-name:--font-inter-stack) text-sm text-emerald-700 dark:text-emerald-400">
							<p class="font-semibold">Inquiry received!</p>
							<p class="mt-1 normal-case tracking-normal">Thanks for your interest. We have been notified and will reach out shortly.</p>
						</div>
					)}

					{errorMessage && (
						<div role="alert" class="mt-5 rounded-lg border border-rose-500/30 bg-rose-500/10 px-3.5 py-3 font-(family-name:--font-inter-stack) text-sm text-rose-700 dark:text-rose-400">
							<p class="font-semibold">Submission failed</p>
							<p class="mt-1 normal-case tracking-normal">{errorMessage}</p>
						</div>
					)}

					<button
						type="submit"
						data-cuelume-tap
						class="group/submit mt-5 inline-flex h-11 w-full cursor-pointer items-center justify-center gap-2 rounded-lg bg-[var(--app-text)] px-5 font-google text-sm font-semibold text-[var(--app-bg)] transition-[opacity,transform] duration-150 hover:opacity-90 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--app-border-strong)] active:scale-[0.98] md:w-auto"
					>
						Send Inquiry
						<svg viewBox="0 0 24 24" class="size-4 transition-transform duration-200 group-hover/submit:translate-x-0.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
							<path d="M5 12h14M13 6l6 6-6 6" />
						</svg>
					</button>
				</form>
			</section>
		</div>
	</main>
</HomescreenLayout>
