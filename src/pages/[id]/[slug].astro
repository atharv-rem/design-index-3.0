---
import HomescreenLayout from "@/layouts/homescreen.astro";
import { getOptimizedImageUrl } from "@/lib/images";
import ToolDetail from "@/components/tool-detail.astro";
import { SPONSORS_PAGE_TAG, getSponsors } from "@/lib/sponsors";
import { getToolWithSuggestions, isValidToolId } from "@/lib/get-tool";

export const prerender = false;

if (Astro.cache.enabled) {
  Astro.cache.set({
    maxAge: 86400,
    swr: 43200,
    tags: [SPONSORS_PAGE_TAG],
  });
}

const { id, slug } = Astro.params;

if (!id) {
  Astro.logger.error("Missing ID parameter in URL params.");
  return Astro.redirect("/");
}

Astro.logger.info(`Rendering tool page for ID: ${id}, slug: ${slug}`);

const toolId = Number(id);

if (!isValidToolId(toolId)) {
  return new Response(null, { status: 404, statusText: "Not Found" });
}

// Sponsors don't depend on the tool, so load them while the tool is being fetched.
const sponsorsPromise = getSponsors().catch(() => []);

let payload;

try {
  payload = await getToolWithSuggestions(toolId);
} catch (error) {
  Astro.logger.error(`Failed to load tool ${id}: ${error}`);
  return new Response(null, { status: 502, statusText: "Bad Gateway" });
}

if (!payload) {
  Astro.logger.warn(`Tool not found for ID: ${id}`);
  return new Response(null, { status: 404, statusText: "Not Found" });
}

const { tool, suggestedTools } = payload;

// Normalize/redirect to expected slug if it doesn't match (comparing decoded strings to prevent infinite loops)
if (decodeURIComponent(slug ?? "") !== tool.tool_name) {
  const canonicalSlug = encodeURIComponent(tool.tool_name);
  Astro.logger.warn(`Non-canonical slug matched '${slug}'. Redirecting to canonical slug: '${canonicalSlug}'`);
  return Astro.redirect(`/${id}/${canonicalSlug}`, 301);
}

// One sponsor is placed first in the suggestions, rotated by tool id.
const sponsors = (await sponsorsPromise).filter((item) => !item.homepage_only);
const sponsor = sponsors.length ? sponsors[Number(id) % sponsors.length] : undefined;

const suggested = [
  ...(sponsor
    ? [{
        href: sponsor.website_url,
        name: sponsor.name,
        description: sponsor.description,
        og_image_link: sponsor.og_image_link,
        sponsored: true,
      }]
    : []),
  ...suggestedTools.map((item) => ({
    href: `/${item.id}/${encodeURIComponent(item.tool_name)}`,
    name: item.tool_name,
    description: item.description,
    og_image_link: item.og_image_link,
  })),
];

const pageTitle =
  `${tool.tool_name} | Design Index`;

const pageDescription =
  `${tool.extended_description}`;

const toolOgImage =
  getOptimizedImageUrl(tool.og_image_link, {
    width: 1200,
    height: 630,
    quality: 82,
    fit: "cover",
  }) || undefined;

---

<HomescreenLayout
  title={pageTitle}
  description={pageDescription}
  keywords={`${tool.tool_name}, design tool`}
  ogImage={toolOgImage}
  backgroundVariant="slate"
  showFooter={false}
  visitUrl={tool.website_url}
  shareTitle={tool.tool_name}
>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Design Index",
        "item": "https://designindex.xyz"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": tool.category ? (tool.category.charAt(0).toUpperCase() + tool.category.slice(1)) : "Tools",
        "item": `https://designindex.xyz/${tool.category || "tools"}`
      },
      {
        "@type": "ListItem",
        "position": 3,
        "name": tool.tool_name,
        "item": Astro.url.href
      }
    ]
  })} />
  <ToolDetail
    name={tool.tool_name}
    description={tool.extended_description}
    websiteUrl={tool.website_url}
    pricing={tool.pricing}
    suggested={suggested}
  />
</HomescreenLayout>
