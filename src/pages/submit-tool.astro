---
import HomescreenLayout from "../layouts/homescreen.astro";
import { actions } from "astro:actions";

export const prerender = false;

const result = Astro.getActionResult(actions.submitTool);

if (result && !result.error) {
  return Astro.redirect(`${Astro.url.pathname}?success=true`);
}

let success = Astro.url.searchParams.get("success") === "true";
let errorMessage = result?.error ? result.error.message : "";

const guidelines = [
	"Submit only design-related tools and resources.",
	"We manually review every submission.",
	"Every link we add is a dofollow link.",
];

const categories = [
	{ value: "colours", label: "Colours" },
	{ value: "mockups", label: "Mockups" },
	{ value: "illustrations", label: "Illustrations" },
	{ value: "icons", label: "Icons" },
	{ value: "fonts", label: "Fonts" },
	{ value: "inspiration", label: "Design Inspiration" },
	{ value: "tools", label: "Tools" },
];

const labelClass = "flex flex-col gap-2 font-google text-sm font-medium tracking-[0.02rem] theme-text-soft";
const fieldClass =
	"rounded-lg border border-app-border bg-app-panel-contrast px-3 font-(family-name:--font-inter-stack) text-sm normal-case tracking-normal theme-text-primary transition-colors placeholder:theme-text-soft hover:border-app-border-strong focus:border-app-border-strong focus:outline-none focus-visible:ring-2 focus-visible:ring-app-border";
---

<HomescreenLayout
	title="Submit a Tool | Design Index"
	description="Submit a design tool or resource to be reviewed and curated for the Design Index directory."
	keywords="submit design tool, design directory submission, add tool to design index"
	backgroundVariant="slate"
>
	<main class="px-5 py-6 md:py-8">
		<div class="mx-auto w-full max-w-xl">
			<header>
				<h1 class="font-google text-4xl font-semibold leading-none tracking-[0.01rem] theme-text-primary md:text-[44px]">Submit a Tool</h1>
				<p class="mt-3 font-(family-name:--font-inter-stack) text-[15px] font-medium leading-5.5 theme-text-muted md:text-base">
					Know a great design resource? Submit it here and we will review it for quality, usefulness, and relevance.
				</p>
			</header>

			<section class="mt-8" aria-labelledby="guidelines-heading">
				<h2 id="guidelines-heading" class="font-google text-xs font-semibold uppercase tracking-[0.12rem] theme-text-soft">Before you submit</h2>
				<ul class="mt-3 divide-y divide-app-border overflow-hidden rounded-xl border border-app-border bg-app-panel-contrast">
					{guidelines.map((item) => (
						<li class="flex items-start gap-3 px-4 py-3.5">
							<span class="mt-0.5 flex size-5 shrink-0 items-center justify-center rounded-full bg-emerald-500/15 text-emerald-600 dark:text-emerald-400">
								<svg viewBox="0 0 24 24" class="size-3" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
									<path d="M5 12.5l4.5 4.5L19 7.5" />
								</svg>
							</span>
							<span class="font-(family-name:--font-inter-stack) text-sm font-medium leading-5 theme-text-muted md:text-[15px]">{item}</span>
						</li>
					))}
				</ul>
			</section>

			<section class="mt-8">
				<form action={actions.submitTool} method="post">
					<div class="grid gap-4 md:grid-cols-2">
						<label class={labelClass}>
							Tool name
							<input type="text" name="toolName" placeholder="Figma" required class:list={["h-11", fieldClass]} />
						</label>

						<label class={labelClass}>
							Tool URL
							<input type="url" name="toolUrl" placeholder="https://example.com" required autocomplete="url" class:list={["h-11", fieldClass]} />
						</label>
					</div>

					<div class="mt-4 grid gap-4 md:grid-cols-2">
						<label class={labelClass}>
							Category
							<select name="category" required class:list={["h-11", fieldClass]}>
								<option value="">Select a category</option>
								{categories.map((category) => (
									<option value={category.value}>{category.label}</option>
								))}
							</select>
						</label>

						<label class={labelClass}>
							Your email
							<input type="email" name="email" placeholder="you@example.com" required autocomplete="email" class:list={["h-11", fieldClass]} />
						</label>
					</div>

					<label class={`mt-4 ${labelClass}`}>
						Why this tool?
						<textarea
							name="reason"
							rows="5"
							placeholder="What makes this tool useful for designers?"
							required
							class:list={["resize-y py-2.5", fieldClass]}
						></textarea>
					</label>

					{success && (
						<div role="status" class="mt-5 rounded-lg border border-emerald-500/30 bg-emerald-500/10 px-3.5 py-3 font-(family-name:--font-inter-stack) text-sm text-emerald-700 dark:text-emerald-400">
							<p class="font-semibold">Submission received!</p>
							<p class="mt-1 normal-case tracking-normal">Thanks for submitting the tool. We have been notified and will review it shortly.</p>
						</div>
					)}

					{errorMessage && (
						<div role="alert" class="mt-5 rounded-lg border border-rose-500/30 bg-rose-500/10 px-3.5 py-3 font-(family-name:--font-inter-stack) text-sm text-rose-700 dark:text-rose-400">
							<p class="font-semibold">Submission failed</p>
							<p class="mt-1 normal-case tracking-normal">{errorMessage}</p>
						</div>
					)}

					<button
						type="submit"
						data-cuelume-tap
						class="group/submit mt-5 inline-flex h-11 w-full cursor-pointer items-center justify-center gap-2 rounded-lg bg-[var(--app-text)] px-5 font-google text-sm font-semibold text-[var(--app-bg)] transition-[opacity,transform] duration-150 hover:opacity-90 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--app-border-strong)] active:scale-[0.98] md:w-auto"
					>
						Submit Tool
						<svg viewBox="0 0 24 24" class="size-4 transition-transform duration-200 group-hover/submit:translate-x-0.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
							<path d="M5 12h14M13 6l6 6-6 6" />
						</svg>
					</button>
				</form>
			</section>
		</div>
	</main>
</HomescreenLayout>
