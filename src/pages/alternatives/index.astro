---
import HomescreenLayout from "@/layouts/homescreen.astro";
import ArticleIndexSection from "@/components/article-index-section.astro";
import { PAGE_YEAR, SITE_URL, getIconPages, jsonLd } from "@/lib/icon-pages";

export const prerender = false;

const { alternatives, roundups } = await getIconPages();

if (Astro.cache.enabled) {
  Astro.cache.set({ maxAge: 3600, swr: 86400, tags: ["icon-articles"] });
}

const alternativeItems = alternatives.map((page) => ({
  href: page.path,
  title: page.title,
  description: `${page.alternatives.length} options, including ${page.alternatives.slice(0, 3).map((tool) => tool.name).join(", ")}`,
}));

const roundupItems = roundups.map((page) => ({
  href: page.path,
  title: page.title,
  description: `${page.tools.length} icon libraries, including ${page.tools.slice(0, 3).map((tool) => tool.name).join(", ")}`,
}));
---

<HomescreenLayout
  title={`Icon Library Alternatives: ${alternatives.length} Comparisons (${PAGE_YEAR})`}
  description={`Looking for an alternative to Font Awesome, Lucide, Material Icons or Tabler? Browse ${alternatives.length} icon library comparisons with pricing and direct links.`}
  keywords="icon library alternatives, icon set comparison, Font Awesome alternatives, Lucide alternatives, Heroicons alternatives"
  backgroundVariant="slate"
>
  <script type="application/ld+json" set:html={jsonLd({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "BreadcrumbList",
        "itemListElement": [
          { "@type": "ListItem", "position": 1, "name": "Design Index", "item": SITE_URL },
          { "@type": "ListItem", "position": 2, "name": "Icons", "item": `${SITE_URL}/icons` },
          { "@type": "ListItem", "position": 3, "name": "Alternatives", "item": `${SITE_URL}/alternatives` },
        ],
      },
      {
        "@type": "ItemList",
        "name": "Icon library alternatives",
        "numberOfItems": alternatives.length,
        "itemListElement": alternatives.map((page, index) => ({
          "@type": "ListItem",
          "position": index + 1,
          "name": page.title,
          "url": `${SITE_URL}${page.path}`,
        })),
      },
    ],
  })} />

  <main class="mt-[12px] px-[20px] pb-20">
    <div class="w-full">
      <h1 class="font-google font-medium text-4xl leading-none theme-text-primary md:text-[40px] tracking-[0.05rem]">Icon library alternatives</h1>
      <p class="mt-3 font-rethink text-[15px] leading-[18px] theme-text-muted md:text-base font-medium">Using Font Awesome, Lucide or Material Icons? Pick the library you know and see the closest alternatives, with pricing and links to each one.</p>
      <ArticleIndexSection heading="Icon library alternatives" items={alternativeItems} />
      <ArticleIndexSection heading="Best icon lists" items={roundupItems} />
    </div>
  </main>
</HomescreenLayout>
