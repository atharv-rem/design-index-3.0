---
import { SquareText } from "lucide-react";
import HomescreenLayout from "@/layouts/homescreen.astro";
import IconToolCard from "@/components/icon-tool-card.astro";
import ArticleHeader from "@/components/article-header.astro";
import ArticleCompareTable from "@/components/article-compare-table";
import ArticleFaq from "@/components/article-faq";
import {
  ARTICLE_AUTHOR,
  ARTICLE_PUBLISHED,
  SITE_URL,
  buildCompareRows,
  getIconPages,
  jsonLd,
} from "@/lib/icon-pages";

export const prerender = false;

let pages;

try {
  pages = await getIconPages();
} catch (error) {
  Astro.logger.error(`Failed to load icon articles: ${error}`);
  return new Response(null, { status: 502, statusText: "Bad Gateway" });
}

const page = pages.alternatives.find((item) => item.slug === Astro.params.slug);

if (!page) {
  return new Response(null, { status: 404, statusText: "Not Found" });
}

if (Astro.cache.enabled) {
  Astro.cache.set({ maxAge: 3600, swr: 86400, tags: ["icon-articles"] });
}

const rows = buildCompareRows(page.alternatives);
const showBestFor = rows.some((row) => row.bestFor);
const pageUrl = `${SITE_URL}${page.path}`;
---

<HomescreenLayout
  title={page.seoTitle}
  description={page.metaDescription}
  keywords={`${page.targetName} alternatives, ${page.targetName} alternative, icon libraries, icon sets`}
  backgroundVariant="slate"
>
  <script type="application/ld+json" set:html={jsonLd({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "BreadcrumbList",
        "itemListElement": [
          { "@type": "ListItem", "position": 1, "name": "Design Index", "item": SITE_URL },
          { "@type": "ListItem", "position": 2, "name": "Icons", "item": `${SITE_URL}/icons` },
          { "@type": "ListItem", "position": 3, "name": "Alternatives", "item": `${SITE_URL}/alternatives` },
          { "@type": "ListItem", "position": 4, "name": page.title, "item": pageUrl },
        ],
      },
      {
        "@type": "ItemList",
        "name": page.title,
        "numberOfItems": page.alternatives.length,
        "itemListElement": page.alternatives.map((tool, index) => ({
          "@type": "ListItem",
          "position": index + 1,
          "name": tool.name,
          "url": `${SITE_URL}${tool.detailHref}`,
        })),
      },
      {
        "@type": "FAQPage",
        "mainEntity": page.faqs.map((faq) => ({
          "@type": "Question",
          "name": faq.question,
          "acceptedAnswer": { "@type": "Answer", "text": faq.answer },
        })),
      },
    ],
  })} />

  <main class="px-5 pb-20 pt-6 md:px-6">
    <div class="mx-auto w-full max-w-[640px]">
      <ArticleHeader code={page.code} title={page.title} author={ARTICLE_AUTHOR} date={ARTICLE_PUBLISHED} />

      <div class="mt-8 space-y-3 text-justify hyphens-auto font-(family-name:--font-inter-stack) text-[17px] font-medium leading-[1.35] theme-text-muted">
        {page.intro.map((paragraph) => <p>{paragraph}</p>)}
        {page.targetTool && (
          <p class="text-[15px]">
            See the full {page.targetName} listing on <a href={page.targetTool.detailHref} class="underline underline-offset-4 theme-text-primary">Design Index</a>.
          </p>
        )}
      </div>

      <section class="mt-10" aria-labelledby="options-heading">
        <h2 id="options-heading" class="font-google text-2xl font-medium theme-text-primary">
          {page.alternatives.length} {page.targetName} alternatives
        </h2>
        <ol class="mt-5 grid grid-cols-1 gap-6 lg:grid-cols-2">
          {page.alternatives.map((tool, index) => (
            <li class="flex">
              <IconToolCard tool={tool} priority={index < 2} currentPath={page.path} />
            </li>
          ))}
        </ol>
      </section>

      <section class="mt-12" aria-labelledby="compare-heading">
        <h2 id="compare-heading" class="font-google text-2xl font-medium theme-text-primary">
          {page.targetName} alternatives compared
        </h2>
        <ArticleCompareTable rows={rows} showBestFor={showBestFor} />
      </section>

      {page.faqs.length > 0 && (
        <section class="mt-12" aria-labelledby="faq-heading">
          <h2 id="faq-heading" class="font-google text-2xl font-medium theme-text-primary">
            Frequently asked questions
          </h2>
          <ArticleFaq client:load faqs={page.faqs} />
        </section>
      )}

      <section class="mt-12" aria-labelledby="related-heading">
        <h2 id="related-heading" class="font-google text-2xl font-medium theme-text-primary">
          Related comparisons
        </h2>
        <ul class="mt-3 flex flex-wrap gap-2">
          {page.related.map((link) => (
            <li>
              <a href={link.href} class="inline-flex items-center gap-1.5 rounded-[12px] px-3 py-1.5 font-google text-[14px] font-semibold theme-text-primary ring-1 ring-black/10 hover:underline dark:ring-white/15">
                <SquareText className="size-4 shrink-0" strokeWidth={2} aria-hidden="true" />
                {link.label}
              </a>
            </li>
          ))}
          <li>
            <a href={page.roundup.href} class="inline-flex items-center gap-1.5 rounded-[12px] px-3 py-1.5 font-google text-[14px] font-semibold theme-text-primary ring-1 ring-black/10 hover:underline dark:ring-white/15">
              <SquareText className="size-4 shrink-0" strokeWidth={2} aria-hidden="true" />
              {page.roundup.label}
            </a>
          </li>
        </ul>
      </section>
    </div>
  </main>
</HomescreenLayout>
