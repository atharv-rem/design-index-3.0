---
import { supabase } from "@/lib/supabase";
import { getOptimizedImageUrl } from "@/lib/images";

const { data } = await supabase
	.from("design_index")
	.select("primary_key, tool_name, description, og_image_link")
	.order("date", { ascending: false, nullsFirst: false })
	.limit(10);

const tools = (data ?? []).map((row) => ({
	name: row.tool_name as string,
	href: `/${row.primary_key}/${encodeURIComponent(row.tool_name)}`,
	description: (row.description as string | null)?.trim() || null,
	image: getOptimizedImageUrl(row.og_image_link, { width: 400, height: 210 }),
}));
---

{tools.length > 0 && (
	<section aria-labelledby="recently-added-tools" class="mx-auto w-full max-w-[1250px] px-5 pb-20 md:px-8">
		<h2 id="recently-added-tools" class="font-(family-name:--font-inter-stack) text-[24px] font-medium leading-[1.05] tracking-[-0.03em] text-black dark:text-white sm:text-3xl md:text-[36px]">
			Recently added tools
		</h2>

		<ul class="mt-8 grid grid-cols-1 gap-4 sm:grid-cols-2 md:mt-10 md:grid-cols-3 md:gap-5 lg:grid-cols-5">
			{tools.map((tool) => (
				<li class="flex">
					<a
						href={tool.href}
						data-astro-prefetch
						class="group flex w-full flex-col overflow-hidden rounded-xl border border-black/10 bg-white transition duration-200 hover:-translate-y-1 dark:border-white/10 dark:bg-[#18181b]"
					>
						{tool.image && (
							<img
								src={tool.image}
								alt={`${tool.name} preview`}
								width="400"
								height="210"
								loading="lazy"
								decoding="async"
								class="aspect-[1.9/1] w-full object-cover"
							/>
						)}
						<div class="p-4">
							<h3 class="font-google text-[17px] font-medium leading-tight tracking-[-0.01em] text-[#2b2b2b] dark:text-neutral-100">{tool.name}</h3>
							{tool.description && (
								<p class="mt-1.5 line-clamp-3 font-(family-name:--font-inter-stack) text-[13px] font-normal leading-snug text-neutral-600 dark:text-neutral-400">{tool.description}</p>
							)}
						</div>
					</a>
				</li>
			))}
		</ul>
	</section>
)}
