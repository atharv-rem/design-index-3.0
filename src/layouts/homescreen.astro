---
import '../styles/global.css';
import HomeSidebar from '../components/home-sidebar';
import SiteFooter from '../components/site-footer.astro';
import { SEO } from 'astro-seo';
import { getImage } from 'astro:assets';
import heartIcon from '../assets/love.png';

const optimizedHeart = await getImage({ src: heartIcon, width: 16, height: 16 });

type Props = {
    title?: string;
    description?: string;
    keywords?: string;
    noindex?: boolean;
    ogType?: 'website' | 'article';
    ogImage?: string;
    backgroundVariant?: 'image' | 'slate';
    showDefaultSidebarTrigger?: boolean;
    floatingNavbarSocialLinks?: Array<{ label: string; href: string; icon: string }>;
    showFooter?: boolean;
    visitUrl?: string;
    shareTitle?: string;
};

const {
    title = 'Design Index | Curated Design Tools, Resources, and Inspiration',
    description = 'Discover curated design tools, mockups, icons, fonts, color resources, and inspiration in one fast searchable index.',
    keywords = 'design tools, design resources, mockups, icons, fonts, color palettes, design inspiration, UI resources',
    noindex = false,
    ogType = 'website',
    ogImage: customOgImage,
    backgroundVariant = 'image',
    showDefaultSidebarTrigger = false,
    floatingNavbarSocialLinks = [],
    showFooter = true,
    visitUrl,
    shareTitle,
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site || 'https://designindex.xyz').href;
const faviconVersion = '20260331';
const faviconSvg = `/favicon.svg?v=${faviconVersion}`;

const defaultOgImage = new URL(
    `/api/og.png?title=${encodeURIComponent(title)}&description=${encodeURIComponent(description)}`,
    Astro.url
).href;
const ogImage = customOgImage || defaultOgImage;
---

<html lang="en">
    <head>
        <meta charset="utf-8" />
        <script
          src="https://cdn.databuddy.cc/databuddy.js"
          data-client-id="CzkF34Qr773cOXFFoHjzM"
          data-track-performance="false"
          crossorigin="anonymous"
          async
        ></script>
        <link rel="icon" type="image/svg+xml" href={faviconSvg} />
        <meta name="viewport" content="width=device-width" />
        <meta name="generator" content={Astro.generator} />
        <SEO
            title={title}
            description={description}
            canonical={canonicalUrl}
            noindex={noindex}
            nofollow={noindex}
            robotsExtras={noindex ? undefined : 'max-image-preview:large,max-snippet:-1,max-video-preview:-1'}
            openGraph={{
                basic: {
                    title: title,
                    type: ogType,
                    image: ogImage,
                    url: canonicalUrl,
                },
                optional: {
                    siteName: 'Design Index',
                    locale: 'en_US',
                    description: description,
                },
                image: {
                    alt: 'Design Index',
                }
            }}
            twitter={{
                card: 'summary_large_image',
                title: title,
                description: description,
                image: ogImage,
                imageAlt: 'Design Index',
            }}
            extend={{
                meta: [
                    { name: 'keywords', content: keywords },
                    { name: 'author', content: 'Atharv Remeshan' },
                    { name: 'theme-color', content: '#000000' },
                ],
                link: [
                    { rel: 'sitemap', href: '/sitemap-index.xml' }
                ]
            }}
        />
        <script is:inline>
            (() => {
                const storageKey = 'design-index-theme';
                const root = document.documentElement;
                const storedTheme = localStorage.getItem(storageKey);
                const isDark = storedTheme ? storedTheme === 'dark' : true;

                root.classList.toggle('dark', isDark);
                root.dataset.theme = isDark ? 'dark' : 'light';

                const metaTheme = document.querySelector('meta[name="theme-color"]');
                if (metaTheme) {
                    metaTheme.setAttribute('content', isDark ? '#000000' : '#ffffff');
                }
            })();
        </script>

        <script type="application/ld+json" set:html={JSON.stringify({
          "@context": "https://schema.org",
          "@graph": [
            {
              "@type": "WebSite",
              "@id": "https://designindex.xyz/#website",
              "url": "https://designindex.xyz/",
              "name": "Design Index",
              "alternateName": ["DesignIndex"],
              "description": "Discover curated design tools, mockups, icons, fonts, color resources, and inspiration in one fast searchable index.",
              "potentialAction": {
                "@type": "SearchAction",
                "target": {
                  "@type": "EntryPoint",
                  "urlTemplate": "https://designindex.xyz/tools?q={search_term_string}"
                },
                "query-input": "required name=search_term_string"
              }
            },
            {
              "@type": "Organization",
              "@id": "https://designindex.xyz/#organization",
              "name": "Design Index",
              "url": "https://designindex.xyz/",
              "logo": "https://designindex.xyz/favicon.svg"
            },
            {
              "@type": "ItemList",
              "@id": "https://designindex.xyz/#sitenavigation",
              "name": "Site Navigation",
              "itemListElement": [
                {
                  "@type": "SiteNavigationElement",
                  "position": 1,
                  "name": "Mockups",
                  "url": "https://designindex.xyz/mockups"
                },
                {
                  "@type": "SiteNavigationElement",
                  "position": 2,
                  "name": "Icons",
                  "url": "https://designindex.xyz/icons"
                },
                {
                  "@type": "SiteNavigationElement",
                  "position": 3,
                  "name": "Fonts",
                  "url": "https://designindex.xyz/fonts"
                },
                {
                  "@type": "SiteNavigationElement",
                  "position": 4,
                  "name": "Colours",
                  "url": "https://designindex.xyz/colours"
                },
                {
                  "@type": "SiteNavigationElement",
                  "position": 5,
                  "name": "UI Kits",
                  "url": "https://designindex.xyz/ui"
                },
                {
                  "@type": "SiteNavigationElement",
                  "position": 6,
                  "name": "Illustrations",
                  "url": "https://designindex.xyz/illustrations"
                },
                {
                  "@type": "SiteNavigationElement",
                  "position": 7,
                  "name": "Design Inspiration",
                  "url": "https://designindex.xyz/design-inspo"
                },
                {
                  "@type": "SiteNavigationElement",
                  "position": 8,
                  "name": "Tools",
                  "url": "https://designindex.xyz/tools"
                },
                {
                  "@type": "SiteNavigationElement",
                  "position": 9,
                  "name": "About",
                  "url": "https://designindex.xyz/about"
                }
              ]
            }
          ]
        })} />
    </head>
    <body class="theme-body-bg relative min-h-screen font-rethink">
        <div class="theme-body-bg fixed inset-0 -z-10" />
        <HomeSidebar
            client:load
            showDefaultTrigger={showDefaultSidebarTrigger}
            floatingNavbarSocialLinks={floatingNavbarSocialLinks}
            visitUrl={visitUrl}
            shareTitle={shareTitle}
            heartIconSrc={optimizedHeart.src}
        >
            <slot />
            {showFooter && <SiteFooter />}
        </HomeSidebar>
        
        <script is:inline>
          (function() {
            if (typeof window !== "undefined" && window.navigator) {
              const modelContext = window.navigator.modelContext;
              if (modelContext && typeof modelContext.registerTool === "function") {
                try {
                  modelContext.registerTool({
                    name: "search_design_index",
                    description: "Search for design resources, tools, templates, mockups, fonts, and color palettes on Design Index.",
                    inputSchema: {
                      type: "object",
                      properties: {
                        query: {
                          type: "string",
                          description: "The search query query string."
                        }
                      },
                      required: ["query"]
                    },
                    execute: async function(args) {
                      try {
                        const res = await fetch("/api/search?q=" + encodeURIComponent(args.query || ""));
                        if (res.ok) {
                          const data = await res.json();
                          return { success: true, results: data };
                        }
                        return { success: false, error: "Failed to fetch search results" };
                      } catch (e) {
                        return { success: false, error: e.message };
                      }
                    }
                  });
                } catch (e) {
                  console.warn("Failed to register WebMCP tool:", e);
                }
              }
            }
          })();
        </script>
    </body>
</html>
